---
// src/layouts/Base.astro
import { absoluteUrl } from '../config/site';
import { estudio } from '../data/estudio';
import '../styles/global.css';

// Sólo el documento: head, cuerpo y el WhatsApp flotante. La cabecera y el pie
// los pone cada layout, porque la home y las páginas de materia tienen chrome
// distinto (site-head/site-foot contra doc-head/doc-foot).
interface Props {
  title: string;
  description: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImageAlt?: string;
  ogType?: 'website' | 'article';
  /** Ruta absoluta desde la raíz, con barra final. Ej: "/materias/laboral/" */
  ruta: string;
  /** Nodos del grafo schema.org de esta página. */
  schema?: unknown[];
  /** Id del <body>, para las anclas de la home. */
  bodyId?: string;
  /** Enlace de WhatsApp propio, cuando la página quiere un mensaje distinto
      al genérico (el artículo, por ejemplo, dice de dónde viene la consulta). */
  whatsapp?: string;
}

const {
  title,
  description,
  ogTitle,
  ogDescription,
  ogImageAlt = 'Identidad visual del Estudio Jurídico Farfán',
  ogType = 'website',
  ruta,
  schema = [],
  bodyId,
  whatsapp = estudio.whatsapp,
} = Astro.props;

const canonical = absoluteUrl(ruta);
const og = absoluteUrl('/og-farfan.jpg');

const grafo =
  schema.length > 0
    ? JSON.stringify({ '@context': 'https://schema.org', '@graph': schema })
    : null;
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="light" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="robots"
      content="index,follow,max-snippet:-1,max-image-preview:large,max-video-preview:-1"
    />
    <meta name="author" content="Juan Ignacio Farfán" />
    <meta name="theme-color" content="#15251C" />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    {/* Las tres familias que usan todas las hojas del sitio. Se cargan acá y no
        en el CSS porque un @import dentro de la hoja serializa las descargas:
        el navegador tiene que bajar y parsear el CSS antes de enterarse de que
        hay fuentes. El pedido es el mismo que hacía el sitio anterior, con los
        mismos ejes —Fraunces variable por opsz y peso—, así que el dibujo de
        los títulos es el de siempre. Pendiente: autoalojarlas. */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..600;1,9..144,300..500&family=Hanken+Grotesk:wght@300;400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap"
    />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={estudio.nombre} />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:title" content={ogTitle ?? title} />
    <meta property="og:description" content={ogDescription ?? description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {og && <meta property="og:image" content={og} />}
    {og && <meta property="og:image:width" content="1200" />}
    {og && <meta property="og:image:height" content="630" />}
    {og && <meta property="og:image:alt" content={ogImageAlt} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle ?? title} />
    <meta name="twitter:description" content={ogDescription ?? description} />
    {og && <meta name="twitter:image" content={og} />}
    {og && <meta name="twitter:image:alt" content={ogImageAlt} />}

    {grafo && <script type="application/ld+json" set:html={grafo} />}
    <slot name="head" />
  </head>

  <body id={bodyId}>
    <slot />

    {/* Contacto directo por WhatsApp, a la vista en toda la página */}
    <a
      class="wa-float"
      href={whatsapp}
      target="_blank"
      rel="noopener"
      aria-label="Escribir al estudio por WhatsApp"
    >
      <span class="wa-tip" aria-hidden="true">Escribir por WhatsApp</span>
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"
        ><path
          d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"
        ></path></svg
      >
    </a>

    {/* La medición de los clics a WhatsApp va acá, junto al botón flotante:
        así toda página que use este layout queda medida sin repetir el
        listener en cada una. */}
    <script>
      import '../scripts/whatsapp.js';
    </script>
  </body>
</html>
