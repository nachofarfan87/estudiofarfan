---
// src/pages/articulos/index.astro
import Documento from '../../layouts/Documento.astro';
import { publicUrl } from '../../config/site';
import { articulosPorFecha } from '../../data/articulos';
import { ID, nodoSitio, nodoEstudio, nodoAbogado, nodoMigas } from '../../lib/schema';

const articulos = articulosPorFecha();
const ruta = '/articulos/';
const url = publicUrl(ruta);

const schema = [
  nodoSitio(),
  nodoEstudio(),
  nodoAbogado(),
  {
    '@type': 'Blog',
    '@id': `${url}#blog`,
    name: 'Doctrina — Estudio Jurídico Farfán',
    description:
      'Notas y publicaciones sobre la práctica del derecho en la provincia de Jujuy, escritas desde el ejercicio profesional.',
    url,
    inLanguage: 'es-AR',
    publisher: { '@id': ID.estudio },
    author: { '@id': ID.abogado },
    blogPost: articulos.map((a) => ({
      '@type': 'BlogPosting',
      headline: a.titulo,
      description: a.copete,
      datePublished: a.fecha,
      url: publicUrl(`/articulos/${a.slug}/`),
      author: { '@id': ID.abogado },
    })),
  },
  nodoMigas(url, [{ nombre: 'Inicio', url: publicUrl('/') }, { nombre: 'Doctrina' }]),
];
---

<Documento
  title="Doctrina y publicaciones — Estudio Jurídico Farfán"
  description="Notas y artículos sobre la práctica del derecho en Jujuy, escritos desde el ejercicio profesional: procedimiento, plazos y las cargas que la ley no impone."
  ogTitle="Doctrina — Estudio Jurídico Farfán"
  ogDescription="Notas y publicaciones sobre la práctica del derecho en la provincia de Jujuy."
  ruta={ruta}
  schema={schema}
  migaActual="Doctrina"
  seccion={{
    href: '/#articulos',
    miga: 'El estudio',
    cabecera: 'Volver al inicio',
    pie: 'Volver al inicio',
  }}
>
  <main id="contenido">
    <div class="masthead reading">
      <p class="eyebrow">§ Doctrina</p>
      <h1 class="doc-title">Notas y publicaciones</h1>
      <p class="doc-deck">
        Lo que se aprende litigando en la provincia, puesto por escrito: procedimiento,
        plazos y las cargas que la ley no impone.
      </p>
    </div>

    <div class="reading">
      <ol class="indice">
        {articulos.map((a) => (
          <li>
            <a href={`/articulos/${a.slug}/`}>
              <div class="meta">
                <time datetime={a.fecha}>{a.fechaTexto}</time>
                <span class="seccion">{a.seccion}</span>
              </div>
              <h2>{a.titulo}</h2>
              <p class="copete">{a.copete}</p>
              <span class="leer">Leer el artículo <span class="arr" aria-hidden="true">→</span></span>
            </a>
          </li>
        ))}
      </ol>

      <p class="nota">
        Si busca orientación sobre una materia concreta, el <a href="/#materias"
          >índice de materias</a
        > explica cada fuero, y el <a href="/honorarios/">arancel publicado</a> dice de
        antemano cuánto cuesta cada trámite.
      </p>
    </div>
  </main>
</Documento>

<style>
  .indice {
    list-style: none;
    margin: clamp(1.5rem, 4vw, 2.5rem) 0 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .indice li {
    border-bottom: 1px solid var(--line);
  }
  .indice a {
    display: block;
    padding: clamp(1.4rem, 3vw, 2rem) 0;
    transition: opacity 0.25s var(--ease);
  }
  .indice a:hover {
    opacity: 0.72;
  }
  .indice a:focus-visible {
    outline: 2px solid var(--brass-ink);
    outline-offset: 4px;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.1rem;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-soft);
  }
  .meta .seccion {
    color: var(--brass-ink);
  }
  .indice h2 {
    margin-top: 0.7rem;
    font-family: 'Fraunces', Georgia, serif;
    font-weight: 400;
    font-size: clamp(1.35rem, 1rem + 1.2vw, 1.9rem);
    line-height: 1.14;
    letter-spacing: -0.015em;
    color: var(--ink);
    max-width: 24ch;
    text-wrap: balance;
  }
  .copete {
    margin-top: 0.8rem;
    color: var(--text-soft);
    max-width: 64ch;
    font-size: 0.99rem;
    line-height: 1.62;
    text-align: justify;
    hyphens: auto;
    -webkit-hyphens: auto;
  }
  .leer {
    display: inline-block;
    margin-top: 1rem;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--brass-ink);
  }
  .leer .arr {
    transition: transform 0.25s var(--ease);
    display: inline-block;
  }
  .indice a:hover .leer .arr {
    transform: translateX(0.25rem);
  }
  .nota {
    margin-top: clamp(2rem, 4vw, 3rem);
    padding-bottom: clamp(2rem, 5vw, 4rem);
    color: var(--text-soft);
    font-size: 0.95rem;
    max-width: 60ch;
  }
  .nota a {
    color: var(--brass-ink);
    border-bottom: 1px solid var(--brass-line);
  }
  @media (prefers-reduced-motion: reduce) {
    .indice a,
    .leer .arr {
      transition: none;
    }
  }
</style>
