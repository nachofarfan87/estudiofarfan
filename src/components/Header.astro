---
// src/components/Header.astro

interface LinkItem {
  href: string;
  label: string;
  /** 'back' antepone la flecha ←, igual que hace Footer con sus enlaces. */
  direction?: 'back' | 'forward';
}

interface Props {
  variant?: 'home' | 'document';
  brandHref?: string;
  links?: LinkItem[];
  backLinks?: LinkItem[];
  ctaHref?: string;
  ctaLabel?: string;
  overHero?: boolean;
}

const {
  variant = 'home',
  brandHref = variant === 'home' ? '#top' : '/',
  links = [],
  backLinks = [],
  ctaHref = variant === 'home' ? '#contacto' : '/#contacto',
  ctaLabel = variant === 'home' ? 'Consulta' : 'Consultar',
  overHero = false,
} = Astro.props;
---

{
  variant === 'home' ? (
    <>
      <script is:inline>
        document.documentElement.classList.add('js-enabled');
      </script>

      <header class:list={['site-head', { 'over-hero': overHero }]}>
        <div class="head-inner">
          <a class="brand" href={brandHref} aria-label="Estudio Jurídico Farfán, inicio">
            Farfán
            <small>est. 1953</small>
          </a>

          <nav class="nav" aria-label="Principal">
            {links.map((link) => <a href={link.href}>{link.label}</a>)}
          </nav>

          <a class="head-cta" href={ctaHref}>{ctaLabel}</a>

          <button
            class="nav-toggle"
            type="button"
            aria-label="Abrir menú"
            aria-expanded="false"
            aria-controls="mobile-nav"
          >
            <span aria-hidden="true"></span>
            <span aria-hidden="true"></span>
            <span aria-hidden="true"></span>
          </button>
        </div>
      </header>

      <nav class="no-script-nav" aria-label="Navegación sin JavaScript">
        {links.map((link) => <a href={link.href}>{link.label}</a>)}
      </nav>

      <dialog
        class="mobile-nav"
        id="mobile-nav"
        aria-label="Menú principal"
      >
        <span class="m-brand" aria-hidden="true">Farfán</span>
        <button class="mobile-close" type="button" aria-label="Cerrar menú">
          Cerrar <span aria-hidden="true">×</span>
        </button>
        <nav aria-label="Navegación móvil">
          {links.map((link) => <a href={link.href}>{link.label}</a>)}
        </nav>
        <a class="m-cta" href={ctaHref}>
          Solicitar consulta <span aria-hidden="true">→</span>
        </a>
      </dialog>
    </>
  ) : (
    <header class="doc-head">
      <div class="doc-head-inner">
        <a class="brand" href={brandHref} aria-label="Estudio Jurídico Farfán, inicio">
          Farfán <small>Est. 1953</small>
        </a>
        <div class="head-side">
          {backLinks.map((link) => (
            <a class="head-back" href={link.href}>
              {link.direction === 'back' ? (
                <><span class="arr" aria-hidden="true">←</span> {link.label}</>
              ) : (
                link.label
              )}
            </a>
          ))}
          <a class="head-cta" href={ctaHref}>{ctaLabel}</a>
        </div>
      </div>
    </header>
  )
}
